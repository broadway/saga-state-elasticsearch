parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset ''_source'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Cannot access offset ''hits'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Method Broadway\\Saga\\State\\Elasticsearch\\ElasticsearchRepository\:\:buildFilter\(\) has parameter \$filter with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Method Broadway\\Saga\\State\\Elasticsearch\\ElasticsearchRepository\:\:buildFilter\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Method Broadway\\Saga\\State\\Elasticsearch\\ElasticsearchRepository\:\:findOneBy\(\) should return Broadway\\Saga\\State\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Method Broadway\\Saga\\State\\Elasticsearch\\ElasticsearchRepository\:\:searchAndDeserializeHits\(\) has parameter \$query with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Method Broadway\\Saga\\State\\Elasticsearch\\ElasticsearchRepository\:\:searchAndDeserializeHits\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Parameter \#1 \$data of static method Broadway\\Saga\\State\:\:deserialize\(\) expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ElasticsearchRepository.php

		-
			message: '#^Parameter \#2 \$array of function array_map expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/ElasticsearchRepository.php
